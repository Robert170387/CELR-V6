# URL base de la API para el build de producción.
#
# Como el frontend es un Static Site separado del backend en Render, el valor
# DEBE ser la URL absoluta del backend (Render lo inyecta como variable de
# entorno y tiene precedencia sobre este archivo). Ajusta el subdominio:
#   https://celr-backend.onrender.com/api/v1
#
# Si en cambio sirves el frontend desde el mismo dominio que el backend,
# deja la ruta relativa /api/v1.
VITE_API_URL=/api/v1
